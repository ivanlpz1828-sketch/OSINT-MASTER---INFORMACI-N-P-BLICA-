    echo -e "${MAGENTA}[00]${RESET} ${RED}Salir${RESET}"
    echo
    echo -ne "${CYAN}Selecciona: ${RESET}"
    read -r opt
    
    case "$opt" in
        1) bash "$SCRIPTS_DIR/osint/osint-master.sh" ;;
        2) bash "$SCRIPTS_DIR/vwarp/vwarp-install.sh" ;;
        3) bash "$SCRIPTS_DIR/termux-setup/setup.sh" ;;
        0) exit 0 ;;
        *) echo -e "${RED}Inválido${RESET}"; sleep 1 ;;
    esac
    menu
}

