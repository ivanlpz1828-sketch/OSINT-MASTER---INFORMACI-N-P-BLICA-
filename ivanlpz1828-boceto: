#!/data/data/com.termux/files/usr/bin/bash
set -u

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
MAGENTA='\033[0;95m'
CYAN='\033[0;96m'
RESET='\033[0m'

check_termux() {
  if ! command -v pkg >/dev/null 2>&1; then
    echo -e "${RED}Este script es para Termux.${RESET}"
    exit 1
  fi
}

install_deps() {
  echo -e "${CYAN}[1/4] Instalando dependencias...${RESET}"
  pkg update -y >/dev/null 2>&1 || true
  pkg install -y git curl python python-pip jq dnsutils whois openssl > /dev/null 2>&1 || true
  echo -e "${GREEN}Hecho.${RESET}"
}

ensure_tools() {
  mkdir -p ~/tools
  cd ~/tools || exit 1

  if [ ! -d "sherlock" ]; then
    echo -e "${CYAN}[2/4] Instalando Sherlock...${RESET}"
    git clone https://github.com/sherlock-project/sherlock.git >/dev/null 2>&1 || true
  fi

  if [ ! -d "Sublist3r" ]; then
    echo -e "${CYAN}[3/4] Instalando Sublist3r...${RESET}"
    git clone https://github.com/aboul3la/Sublist3r.git >/dev/null 2>&1 || true
  fi

  if [ -d ~/tools/sherlock ]; then
    cd ~/tools/sherlock && python3 -m pip install -q -r requirements.txt >/dev/null 2>&1 || true
  fi

  if [ -d ~/tools/Sublist3r ]; then
    cd ~/tools/Sublist3r && python3 -m pip install -q -r requirements.txt >/dev/null 2>&1 || true
  fi

  echo -e "${GREEN}Herramientas listas.${RESET}"
}

show_header() {
  clear
  echo -e "${CYAN}════════════════════════════════════════════════════════════${RESET}"
  echo -e "${GREEN}OSINT MASTER LEGAL${RESET}"
  echo -e "${CYAN}════════════════════════════════════════════════════════════${RESET}"
  echo
}

menu() {
  show_header
  echo -e "${MAGENTA}[01]${RESET} WHOIS"
  echo -e "${MAGENTA}[02]${RESET} DNS Lookup"
  echo -e "${MAGENTA}[03]${RESET} Subdominios"
  echo -e "${MAGENTA}[04]${RESET} Email en fugas"
  echo -e "${MAGENTA}[05]${RESET} Geolocalizar IP"
  echo -e "${MAGENTA}[06]${RESET} Buscar usuario"
  echo -e "${MAGENTA}[07]${RESET} Perfil público"
  echo -e "${MAGENTA}[08]${RESET} Búsqueda inversa"
  echo -e "${MAGENTA}[09]${RESET} Metadatos EXIF"
  echo -e "${MAGENTA}[10]${RESET} Mi IP"
  echo -e "${MAGENTA}[00]${RESET} Salir"
  echo
  echo -ne "${CYAN}Opción: ${RESET}"
  read -r opt
  echo
  case "$opt" in
    1) whois_domain ;;
    2) dns_lookup ;;
    3) subdomain_enum ;;
    4) pwned_email ;;
    5) ip_lookup ;;
    6) username_search ;;
    7) public_profile_search ;;
    8) reverse_image ;;
    9) exif_check ;;
    10) my_ip ;;
    0) exit 0 ;;
    *) echo -e "${RED}Inválido.${RESET}"; sleep 1 ;;
  esac
  menu
}

whois_domain() {
  show_header
  read -p "Dominio: " domain
  [ -n "$domain" ] || return
  whois "$domain" 2>/dev/null | head -40
  echo && read -p "Enter..."
}

dns_lookup() {
  show_header
  read -p "Dominio: " domain
  [ -n "$domain" ] || return
  echo -e "${GREEN}A Records:${RESET}"
  nslookup -type=A "$domain" 8.8.8.8 2>/dev/null || echo "N/A"
  echo && read -p "Enter..."
}

subdomain_enum() {
  show_header
  read -p "Dominio: " domain
  [ -n "$domain" ] || return
  cd ~/tools/Sublist3r 2>/dev/null || return
  python3 sublist3r.py -d "$domain" 2>/dev/null | head -200
  echo && read -p "Enter..."
}

pwned_email() {
  show_header
  read -p "Email: " email
  [ -n "$email" ] || return
  curl -s -A "Mozilla" "https://haveibeenpwned.com/api/v3/breachedaccount/$email" 2>/dev/null || echo "N/A"
  echo && read -p "Enter..."
}

ip_lookup() {
  show_header
  read -p "IP: " ip
  [ -n "$ip" ] || return
  curl -s "http://ip-api.com/json/$ip" 2>/dev/null || echo "N/A"
  echo && read -p "Enter..."
}

username_search() {
  show_header
